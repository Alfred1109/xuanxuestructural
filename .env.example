# Optional MiniMax configuration. Credentials stay in a server-side config file.
LLM_PROVIDER=minimax
LLM_CONFIG_FILE=/path/to/claude/settings.json
LLM_TEXT_MODEL=MiniMax-M3.1-Flash-Preview
LLM_VISION_MODEL=MiniMax-M3.1-Flash-Preview
LLM_MAX_COMPLETION_TOKENS=32768
# Explicit environment variables take precedence over this project file.
# Alternative: set LLM_API_KEY and LLM_BASE_URL directly outside version control.
